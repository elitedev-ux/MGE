# Optional public overrides: put in client/.env.local or frontend build environment.
# Defaults in client/src/backend-config.ts already point to MGE.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Never put admin passwords or service-role keys in VITE_ variables.
# The Edge Function uses built-in Supabase server-side environment values.
